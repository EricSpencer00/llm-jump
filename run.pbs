#!/bin/bash -l
#PBS -A EVITA
#PBS -q single-gpu
#PBS -l select=1:ngpus=1
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:grand
#PBS -j oe
# usage: qsub -v ARGS="cv --epochs 3;cv --epochs 6" run.pbs   (runs separated by ;)
set -e
cd /grand/EVITA/eric-spencer/llm-jump
module use /soft/modulefiles; module load conda; conda activate base
export PYTHONPATH=pylib PYTHONUNBUFFERED=1
IFS=';' read -ra RUNS <<< "$ARGS"
for r in "${RUNS[@]}"; do python jump.py $r; done
