#!/bin/bash -l
#PBS -A EVITA
#PBS -q by-gpu
#PBS -l select=1:ngpus=4
#PBS -l walltime=12:00:00
#PBS -l filesystems=home:grand
#PBS -j oe
# usage: qsub gap.pbs            (full run)
